{
  "name": "temple-community",
  "version": "1.0.0",
  "description": "Offline temple community management for Sri Lankan temples",
  "author": "Banula Lakwindu",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "seed": "node scripts/seed.mjs",
    "seed:force": "node scripts/seed.mjs --force",
    "dist:clean": "node scripts/clean-release.mjs",
    "installer:bitmaps": "node scripts/make-installer-bitmaps.mjs",
    "dist": "npm run dist:clean && npm run installer:bitmaps && npm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/noto-sans-sinhala": "^5.2.5",
    "@fontsource/source-sans-3": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.banulalakwindu.templecommunity",
    "productName": "Temple Committee",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/db/migrations",
        "to": "migrations"
      },
      {
        "from": "resources/splash.html",
        "to": "splash.html"
      },
      {
        "from": "resources/splash.png",
        "to": "splash.png"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerHeader": "installerHeader.bmp",
      "installerSidebar": "installerSidebar.bmp",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Temple Committee",
      "runAfterFinish": true,
      "artifactName": "TempleCommittee-Setup-${version}.${ext}"
    }
  }
}
